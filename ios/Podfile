# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

# ---------------------------------------------------------------------------------------------
# Use React Native's PREBUILT third-party dependencies instead of compiling them here.
#
# RN 0.80.3 pins fmt 11.0.2 (see node_modules/react-native/third-party-podspecs/
# RCT-Folly.podspec), and fmt 11.0.2 does not compile with Xcode 26's clang:
#
#   Pods/fmt/include/fmt/format-inl.h:59:24 Call to consteval function
#   'fmt::basic_format_string<...>::basic_format_string<FMT_COMPILE_STRING, 0>' is not a
#   constant expression
#
# There is no local workaround. fmt's own -DFMT_USE_CONSTEVAL=0 escape hatch does not apply:
# in 11.0.2 that macro is #defined unconditionally rather than behind #ifndef, so a command-line
# value cannot win (fmt only made it overridable in 11.1). And the version is pinned exactly by
# RN's own podspec, so a plain `pod 'fmt', '<newer>'` conflicts rather than overrides.
#
# Bumping React Native is the upstream fix, but not a small one: 0.81.6 still pins fmt 11.0.2, so
# it would take 0.83+ (fmt 12.1.0), which also moves the native templates and would need
# VisionCamera and worklets-core re-verified against it.
#
# RCT_USE_RN_DEP=1 avoids all of that. RN then pulls folly, fmt, glog and boost as a prebuilt
# ReactNativeDependencies.xcframework from Maven Central, so fmt's implementation header is never
# compiled on this machine and the error cannot occur. The artifacts are published for 0.80.3 —
# both the debug and release tarballs return HTTP 200 — which matters because RN silently falls
# back to building from source when they are missing.
#
# ||= so the source path stays reachable: `RCT_USE_RN_DEP=0 bundle exec pod install`.
#
# Expect `pod install` to download a few hundred MB the first time; it caches under
# ios/Pods/ReactNativeDependencies-artifacts afterwards.
ENV['RCT_USE_RN_DEP'] ||= '1'

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'MoobitRecog' do
  config = use_native_modules!

  # MediaPipe Tasks Vision — supplies PoseLandmarker plus the Metal GPU delegate.
  #
  # NOTE: this version could not be resolved against the CocoaPods trunk from the machine this
  # was written on (its network blocks the spec CDN), so treat it as a starting point. If
  # `pod install` cannot find it, run `pod search MediaPipeTasksVision` and bump. The plugin
  # only uses long-stable Tasks API surface, so a bump should be a no-op.
  pod 'MediaPipeTasksVision', '~> 0.10.14'

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    # https://github.com/facebook/react-native/blob/main/packages/react-native/scripts/react_native_pods.rb#L197-L202
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # Xcode 15's user-script sandbox denies the rsync that CocoaPods' "[CP] Embed Pods
    # Frameworks" phase uses to copy prebuilt frameworks (Hermes among them) into the .app:
    #
    #   Sandbox: rsync.samba(NNNNN) deny(1) file-read-data .../hermes.framework/Info.plist
    #
    # It is a hard build failure whose message says nothing about the cause. scripts/setup-ios.rb
    # sets this on the app target; repeated here so a fresh `pod install` in a checkout that
    # never ran that script still produces a project that builds.
    installer.pods_project.build_configurations.each do |config|
      config.build_settings['ENABLE_USER_SCRIPT_SANDBOXING'] = 'NO'
    end

    installer.aggregate_targets.each do |aggregate_target|
      user_project = aggregate_target.user_project
      next if user_project.nil?

      user_project.native_targets.each do |native_target|
        native_target.build_configurations.each do |config|
          config.build_settings['ENABLE_USER_SCRIPT_SANDBOXING'] = 'NO'
        end
      end
      user_project.save
    end
  end
end
