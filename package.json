{
  "name": "moobit-recognition-harness",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "devserver": "node tools/dev-server/server.js",
    "dev": "concurrently -n metro,telemetry -c cyan,magenta \"npm:start\" \"npm:devserver\"",
    "model:download": "bash scripts/download-model.sh",
    "postinstall": "node scripts/patch-rn-podspec.js",
    "patch:rn": "node scripts/patch-rn-podspec.js",
    "setup:ios": "npm run patch:rn && npm run model:download && bundle exec ruby scripts/setup-ios.rb && cd ios && bundle exec pod install",
    "setup:android": "npm run model:download",
    "setup:xcodeproj": "bundle exec ruby scripts/setup-ios.rb",
    "replay": "tsx src/dev/replayCli.ts",
    "probe:geometry": "tsx src/dev/probeGeometry.ts",
    "probe:signals": "tsx src/dev/probeSignals.ts",
    "probe:features": "tsx src/dev/probeFeatures.ts",
    "probe:style": "tsx src/dev/probeStyle.ts",
    "probe:run": "tsx src/dev/probeRun.ts",
    "probe:stress": "tsx src/dev/probeStress.ts",
    "probe:all": "npm run probe:geometry && npm run probe:signals && npm run probe:features && npm run probe:style && npm run probe:run && npm run probe:stress",
    "adb:reverse": "adb reverse tcp:8787 tcp:8787 && adb reverse tcp:8081 tcp:8081"
  },
  "dependencies": {
    "@dr.pogodin/react-native-fs": "2.40.1",
    "@react-native/new-app-screen": "0.80.3",
    "react": "19.1.0",
    "react-native": "0.80.3",
    "react-native-safe-area-context": "^5.5.2",
    "react-native-svg": "15.15.5",
    "react-native-vision-camera": "4.7.3",
    "react-native-worklets-core": "1.6.3"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/plugin-proposal-nullish-coalescing-operator": "^7.18.6",
    "@babel/plugin-proposal-optional-chaining": "^7.21.0",
    "@babel/plugin-transform-arrow-functions": "^7.29.7",
    "@babel/plugin-transform-shorthand-properties": "^7.29.7",
    "@babel/plugin-transform-template-literals": "^7.29.7",
    "@babel/preset-env": "^7.25.3",
    "@babel/preset-typescript": "^7.29.7",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "19.1.2",
    "@react-native-community/cli-platform-android": "19.1.2",
    "@react-native-community/cli-platform-ios": "19.1.2",
    "@react-native/babel-preset": "0.80.3",
    "@react-native/eslint-config": "0.80.3",
    "@react-native/metro-config": "0.80.3",
    "@react-native/typescript-config": "0.80.3",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.13",
    "@types/node": "^22.10.0",
    "@types/react": "^19.1.0",
    "@types/react-test-renderer": "^19.1.0",
    "concurrently": "^9.1.2",
    "eslint": "^8.19.0",
    "express": "^5.2.1",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "19.1.0",
    "tsx": "^4.23.12",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20"
  }
}
